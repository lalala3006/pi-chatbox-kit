{
  "name": "pi-chatbox-kit",
  "version": "0.3.2",
  "private": false,
  "type": "module",
  "description": "Reusable Pi-powered chatbox for React and Node.js applications",
  "license": "MIT",
  "author": "lalala3006",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalala3006/pi-chatbox-kit.git"
  },
  "homepage": "https://github.com/lalala3006/pi-chatbox-kit#readme",
  "bugs": { "url": "https://github.com/lalala3006/pi-chatbox-kit/issues" },
  "keywords": ["pi-agent", "chatbox", "react", "llm", "chat", "oauth"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "REQUIREMENTS.md",
    "examples/react-node/*.ts",
    "examples/react-node/*.tsx",
    "examples/react-node/*.html",
    "examples/react-node/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "example:server": "npm run build && tsx examples/react-node/server.ts",
    "example:web": "npm run build && vite --config examples/react-node/vite.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  }
}
